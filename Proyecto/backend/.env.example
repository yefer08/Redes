# ==============================================================================
# VARIABLES DE ENTORNO - BACKEND WINDOWS SERVER (NODE.JS v14.21.3)
# ==============================================================================

# Entorno de ejecución
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Motor de base de datos a utilizar ('mysql' o 'postgres')
DB_TYPE=mysql

# Configuración de Conexión a Base de Datos
# NOTA: En Windows Server, usar 127.0.0.1 es más rápido y previene cuelgues por resolución IPv6 (::1).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456789
DB_NAME=mi_base_datos
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000

# TLS / SSL para Bases de Datos remotas en Cloud (AWS RDS, Supabase, Neon, Azure)
# Si Windows Server 2012 rechaza el certificado con UNABLE_TO_VERIFY_LEAF_SIGNATURE:
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
